<%- include('header') %>
    <% const isEdit=typeof banana !=='undefined' ; %>
        <h2>
            <%= isEdit ? 'Edit banana' : 'New banana' %>
        </h2>
        <form method="POST">
            <div class="mb-3">
                <label for="color" class="form-label">Color</label>
                <input type="text" class="form-control" id="color" name="color"
                    value="<%= isEdit ? banana.color : '' %>" />
            </div>
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="sweet" name="sweet" <%=isEdit && banana.sweet
                    ? 'checked' : '' %> />
                <label for="sweet" class="form-check-label">Sweet</label>
            </div>
            <div class="mb-3">
                <label for="monkeyId" class="form-label">Owner</label>
                <select class="form-select" id="monkeyId" name="monkeyId">
                    <option value="">- nincs gazdája -</option>
                    <% monkeys.forEach(m=> { %>
                        <option value="<%= m.id %>" <%=isEdit && banana.monkeyId===m.id ? 'selected' : '' %>><%= m.name
                                %>
                        </option>
                        <% }) %>
                </select>
            </div>
            <div class="d-flex gap-2">
                <input type="submit" class="btn btn-primary flex-fill" value="Save" />
                <a href="/bananas" class="btn btn-warning flex-fill">Cancel</a>
            </div>
        </form>
        <%- include('footer') %>